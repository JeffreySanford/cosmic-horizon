# Normalize line endings to LF for source files
* text=auto eol=lf

# Keep binary files unchanged
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Lock executable scripts for Windows/Unix neutrality
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
